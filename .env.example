# Copy this to EvesGarden.env (next to gui.exe) or .env (next to the source)
# and fill in your own values. Doing it by hand is optional: on first run the
# app shows a "Connect Spotify" screen, verifies what you paste, and writes
# the file for you.

# Free, from https://developer.spotify.com/dashboard
# Create an app, give it any name, then copy these two values.
SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here

# Optional. Only needed if you want Rich Presence to appear under your own
# Discord application rather than the one the app ships with.
# DISCORD_CLIENT_ID=
